# Copiez ce fichier en ".env.local" puis collez vos clés Supabase
# (Supabase > Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Mot de passe de l'espace /admin (à définir aussi sur Netlify : Environment variables).
ADMIN_PASSWORD=

# Clé SECRÈTE Supabase (Project Settings > API Keys > secret / service_role). Uniquement côté serveur.
SUPABASE_SERVICE_ROLE_KEY=
